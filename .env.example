# Copia este archivo como .env y ajusta los valores. NUNCA subas el .env real.
# Base de datos: SQLite local (por defecto) o PostgreSQL (Docker Compose / Render)
DATABASE_URL=sqlite:///./vetcare.db
# Cargar los datos oficiales (CSV) al iniciar si la base está vacía
SEED_ON_START=true
# Solo para Docker Compose (PostgreSQL)
POSTGRES_USER=vetcare
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=vetcare
