        "title": "TutorIn"
      },
      "TutorOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "telefono": {
            "type": "string",
            "title": "Telefono"
          },
          "correo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correo"
          },
          "ciudad": {
            "type": "string",
