                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mascota Id"
          },
          "motivo": {
            "type": "string",
            "title": "Motivo",
            "default": ""
          },
          "ahora": {
            "type": "string",
            "format": "date-time",
