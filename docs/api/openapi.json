  "components": {
    "schemas": {
      "CitaIn": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "mascota_id": {
            "type": "integer",
            "title": "Mascota Id"
          },
          "inicio": {
            "type": "string",
            "format": "date-time",
            "title": "Inicio"
          },
          "fin": {
            "type": "string",
            "format": "date-time",
            "title": "Fin"
          }
        },
        "type": "object",
        "required": [
          "id",
          "mascota_id",
          "inicio",
          "fin"
        ],
        "title": "CitaIn"
      },
      "EventoOut": {
        "properties": {
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "ocurrido": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurrido"
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "ocurrido"
        ],
        "title": "EventoOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineaIn": {
        "properties": {
          "recurso_id": {
            "type": "string",
            "title": "Recurso Id",
            "examples": [
              "VET-P001"
            ]
          },
          "cantidad": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Cantidad",
            "description": "Debe ser mayor a cero",
            "examples": [
              2
            ]
          }
        },
        "type": "object",
        "required": [
          "recurso_id",
          "cantidad"
        ],
        "title": "LineaIn"
      },
      "LineaOut": {
        "properties": {
          "recurso_id": {
            "type": "string",
            "title": "Recurso Id"
          },
          "cantidad": {
            "type": "integer",
            "title": "Cantidad"
          },
          "precio_unitario_mxn": {
            "type": "string",
            "title": "Precio Unitario Mxn"
          },
          "subtotal_mxn": {
            "type": "string",
            "title": "Subtotal Mxn"
          }
        },
        "type": "object",
        "required": [
          "recurso_id",
          "cantidad",
          "precio_unitario_mxn",
          "subtotal_mxn"
        ],
        "title": "LineaOut"
      },
      "MascotaIn": {
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "title": "Nombre",
            "examples": [
              "Luna"
            ]
          },
          "propietario_id": {
            "type": "string",
            "title": "Propietario Id",
            "examples": [
              "VET-C001"
            ]
          },
          "alergias": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alergias",
            "examples": [
              [
                "penicilina"
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "nombre",
          "propietario_id"
        ],
        "title": "MascotaIn"
      },
      "MascotaOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "propietario_id": {
            "type": "string",
            "title": "Propietario Id"
          },
          "alergias": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Alergias"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "propietario_id",
          "alergias"
        ],
        "title": "MascotaOut"
      },
      "OperacionIn": {
        "properties": {
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "examples": [
              "VET-C001"
            ]
          },
          "lineas": {
            "items": {
              "$ref": "#/components/schemas/LineaIn"
            },
            "type": "array",
            "minItems": 1,
            "title": "Lineas"
          },
          "promocion_activa": {
            "type": "boolean",
            "title": "Promocion Activa",
            "default": false
          },
          "autorizado": {
            "type": "boolean",
            "title": "Autorizado",
            "default": true
          },
          "referencia": {
            "type": "string",
            "title": "Referencia",
            "default": ""
          },
          "fecha_solicitud": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fecha Solicitud"
          }
        },
        "type": "object",
        "required": [
          "actor_id",
          "lineas"
        ],
        "title": "OperacionIn"
      },
      "OperacionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "fecha_solicitud": {
            "type": "string",
            "format": "date",
            "title": "Fecha Solicitud"
          },
          "total_mxn": {
            "type": "string",
            "title": "Total Mxn"
          },
          "lineas": {
            "items": {
              "$ref": "#/components/schemas/LineaOut"
            },
            "type": "array",
            "title": "Lineas"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actor_id",
          "estado",
          "fecha_solicitud",
          "total_mxn",
          "lineas"
        ],
        "title": "OperacionOut"
      },
      "RecetaIn": {
        "properties": {
          "medicamento": {
            "type": "string",
            "title": "Medicamento",
            "examples": [
              "Penicilina G"
            ]
          },
          "sustancias": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sustancias",
            "examples": [
              [
                "penicilina"
              ]
            ]
          },
          "confirmar_conscientemente": {
            "type": "boolean",
            "title": "Confirmar Conscientemente",
            "default": false
          },
          "veterinario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Veterinario"
          }
        },
        "type": "object",
        "required": [
          "medicamento",
          "sustancias"
        ],
        "title": "RecetaIn"
      },
      "RecetaOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "mascota_id": {
            "type": "integer",
            "title": "Mascota Id"
          },
          "medicamento": {
            "type": "string",
            "title": "Medicamento"
          },
          "con_alerta": {
            "type": "boolean",
            "title": "Con Alerta"
          },
          "autorizada_por": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Autorizada Por"
          }
        },
        "type": "object",
        "required": [
          "id",
          "mascota_id",
          "medicamento",
          "con_alerta",
          "autorizada_por"
        ],
        "title": "RecetaOut"
      },
      "TutorIn": {
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "title": "Nombre",
            "examples": [
              "Ana Torres"
            ]
          },
          "telefono": {
            "type": "string",
            "title": "Telefono",
            "default": "",
            "examples": [
              "81 1234 5678"
            ]
          },
          "correo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correo",
            "examples": [
              "ana@correo.com"
            ]
          },
          "ciudad": {
            "type": "string",
            "title": "Ciudad",
            "default": ""
          },
          "confirmar_distinta_persona": {
            "type": "boolean",
            "title": "Confirmar Distinta Persona",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "nombre"
